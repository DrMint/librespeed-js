{
  "name": "librespeed-js",
  "version": "0.1.0",
  "description": "Promise-based TypeScript client for LibreSpeed backends",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "librespeed",
    "speedtest",
    "bandwidth",
    "network",
    "ping",
    "download",
    "upload"
  ],
  "author": "DrMint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrMint/librespeed-js.git"
  },
  "bugs": {
    "url": "https://github.com/DrMint/librespeed-js/issues"
  },
  "homepage": "https://github.com/DrMint/librespeed-js#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
