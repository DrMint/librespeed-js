{
  "name": "librespeed-js",
  "version": "0.1.0",
  "description": "Promise-based TypeScript client for LibreSpeed backends",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "demo": "tsx test.ts",
    "changelog": "git-cliff --unreleased --strip all",
    "changelog:write": "git-cliff -o CHANGELOG.md",
    "release:prep": "node scripts/release-prep.mjs",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "librespeed",
    "speedtest",
    "bandwidth",
    "network",
    "ping",
    "download",
    "upload"
  ],
  "author": "DrMint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrMint/librespeed-js.git"
  },
  "bugs": {
    "url": "https://github.com/DrMint/librespeed-js/issues"
  },
  "homepage": "https://github.com/DrMint/librespeed-js#readme",
  "publishConfig": {
    "access": "public"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/pre-commit.sh"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "git-cliff": "^2.13.1",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
